{
  "expo": {
    "name": "Foodie",
    "slug": "foodie",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sk.tjm.foodie",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Foodie scans barcodes, best-before dates, and produce photos.",
        "NSPhotoLibraryUsageDescription": "Foodie can import food photos for offline recognition.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:REPLACE_WITH_FRONTEND_HOST"]
    },
    "android": {
      "package": "sk.tjm.foodie",
      "adaptiveIcon": {
        "backgroundColor": "#0F1A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "android.permission.CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "REPLACE_WITH_FRONTEND_HOST",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "foodie",
              "host": "auth",
              "pathPrefix": "/verify"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Foodie to scan barcodes, expiry dates, and produce.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F1A14",
          "defaultChannel": "expiry"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F1A14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "local-foodie-sidestore"
      }
    }
  }
}
